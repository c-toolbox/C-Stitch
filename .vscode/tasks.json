{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/builds/vs2026-64bit-qt6X",
                "-G",
                "Visual Studio 18 2026",
                "-A",
                "x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "--build",
            "${workspaceFolder}/builds/vs2026-64bit-qt6X",
            "--config",
            "RelWithDebInfo"
        }
    ]
}